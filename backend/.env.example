# Production / normal PostgreSQL runner (npm start)
DATABASE_URL=postgresql://user:password@localhost:5432/crowdmind
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URL=http://localhost:5173
# Required for real password reset delivery. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Local runner uses an isolated database and file mail automatically.
